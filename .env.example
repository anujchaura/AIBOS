# ============================================================
# AIBOS – Enterprise AI Multi-Agent Business Operating System
# Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── JWT Auth ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Database – MongoDB ─────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/aibos
MONGODB_DB_NAME=aibos

# ─── Database – Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI / LLM ────────────────────────────────────────────────
# Choose one (or both):
OPENAI_API_KEY=sk-...your-openai-key...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=...your-gemini-key...
GEMINI_MODEL=gemini-1.5-pro

# Primary LLM provider: "openai" | "gemini"
LLM_PROVIDER=openai

# ─── Vector Database – ChromaDB ──────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=aibos_knowledge

# ─── AI Services (FastAPI) ───────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=internal_service_key_change_me

# ─── File Storage ────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── Email (SMTP – for MCP Email Tool & Notifications) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── External APIs (for MCP Tools) ──────────────────────────
OPENWEATHER_API_KEY=...your-openweather-key...
SERP_API_KEY=...your-serpapi-key...

# ─── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_APP_NAME=AIBOS

# ─── MFA (TOTP) ──────────────────────────────────────────────
MFA_APP_NAME=AIBOS

# ─── Celery (Workflow Engine) ─────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
